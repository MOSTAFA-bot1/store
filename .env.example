# API server
PORT=5000

# Set a random value with at least 32 characters before production deployment
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional admin account seed (defaults to admin@moda.sa / Admin@12345 in development only)
ADMIN_EMAIL=admin@moda.sa
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=مدير مودا
